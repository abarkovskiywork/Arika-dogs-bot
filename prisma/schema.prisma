// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum ServiceType {
  walk
  boarding
  home_visit
  cleaning
}

enum TrackingMode {
  auto_done
  ask_daily
}

model Booking {
  id              Int       @id @default(autoincrement())
  userTelegramId  String
  username        String?
  serviceType     String
  startDate       DateTime
  endDate         DateTime
  walkTime        String?
  status          String    @default("pending")
  createdAt       DateTime  @default(now())
}

model ServiceEvent {
  id              Int          @id @default(autoincrement())
  googleEventId   String       @unique
  calendarId      String
  dogName         String
  serviceType     ServiceType
  price           Int
  walksPerDay     Int          @default(1)
  trackingMode    TrackingMode @default(auto_done)
  startDate       DateTime
  endDate         DateTime
  isActive        Boolean      @default(true)
  needsSetup      Boolean      @default(false)
  createdAt       DateTime     @default(now())

  walkLogs        WalkLog[]
}

model WalkLog {
  id              Int      @id @default(autoincrement())
  serviceEventId  Int
  serviceEvent    ServiceEvent @relation(fields: [serviceEventId], references: [id], onDelete: Cascade)

  date            DateTime
  walksCount      Int
  durationMinutes Int?
  note            String?
  completed       Boolean?
  createdAt       DateTime @default(now())
}

model UserSettings {
  userId       String @id
  digestTime   String @default("09:00")
  reminderTime String @default("22:00")
}
